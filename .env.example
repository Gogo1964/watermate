###############################################################################
# WaterMate configuration
#
# Copy to `.env` and adjust. Every value shown here is the built-in default,
# so you only need to keep the lines you actually change.
#
# Values already present in the real environment (systemd, Docker, shell) take
# precedence over this file — never commit a `.env` containing real secrets.
###############################################################################

# --- Water meter --------------------------------------------------------- #

# Base URL of the meter's file server (no trailing slash).
# The daily file is fetched as <BASE_URL>/<pattern with {date} replaced>.
WATER_METER_BASE_URL=http://192.168.1.50/fileserver/log/data

# File name pattern. `{date}` is replaced with the local calendar date.
WATER_METER_FILE_PATTERN=data_{date}.csv

# Meter/channel identifier in CSV column 2. Rows from other channels are stored
# but not monitored. Reports and alerts always refer to this one channel.
METER_CHANNEL=main

# Unit of the cumulative reading in column 3, and how many litres it holds.
# Used purely for display ("0.240 m³ (240 L)").
METER_UNIT=m³
METER_LITERS_PER_UNIT=1000

# Optional HTTP basic auth for the meter's file server.
#HTTP_USERNAME=
#HTTP_PASSWORD=

# --- CSV layout ----------------------------------------------------------- #
# Only change these if your meter writes a different column order.

CSV_DELIMITER=,
CSV_TIMESTAMP_COLUMN=1
CSV_CHANNEL_COLUMN=2
CSV_VALUE_COLUMN=3
CSV_STATUS_COLUMN=8
# A row counts only when the status column matches this exactly (case-insensitive).
CSV_OK_STATUS=no error

# --- Polling -------------------------------------------------------------- #

# How often the meter is polled, in minutes.
POLL_INTERVAL_MINUTES=15

# Run one poll immediately at startup instead of waiting a full interval.
POLL_ON_START=true

# How many past days are re-checked each cycle so an outage loses no data.
# Days that are over and were downloaded successfully are never fetched again.
BACKFILL_DAYS=7

# Minutes after midnight before a finished day's file is considered final.
FILE_FINALIZE_GRACE_MINUTES=60

# HTTP behaviour towards the (embedded, occasionally slow) meter.
HTTP_TIMEOUT_MS=15000
HTTP_RETRIES=3
HTTP_RETRY_BASE_DELAY_MS=1000
HTTP_USER_AGENT=WaterMate/1.0

# --- Time ----------------------------------------------------------------- #

# IANA timezone. Decides which readings belong to "yesterday", when the daily
# report is sent, and how day boundaries are drawn. DST is handled.
TIMEZONE=Europe/Berlin

# --- Data quality --------------------------------------------------------- #

# How often the meter is expected to write a reading. Used to spot gaps and to
# state "X of ~Y expected readings" in the report.
EXPECTED_READING_INTERVAL_MINUTES=5

# A pause longer than this counts as a data gap. Continuous-flow episodes are
# ended at a gap rather than assumed to continue through it.
# Must be greater than EXPECTED_READING_INTERVAL_MINUTES.
MAX_GAP_MINUTES=30

# Negative differences within this band are floating-point noise; anything
# larger is reported as a meter decrease and excluded from the total.
METER_DECREASE_TOLERANCE=0.0005

# A single interval jumping more than this is flagged as implausible. It is
# still counted, but listed in the report so you can verify it.
MAX_PLAUSIBLE_DELTA=1

# How old the reading before midnight may be to serve as the day's baseline.
BASELINE_MAX_AGE_HOURS=24

# --- Daily report --------------------------------------------------------- #

DAILY_REPORT_ENABLED=true

# Local time at which yesterday's report is sent (HH:MM).
DAILY_REPORT_TIME=07:00

# How many missed days are caught up after downtime. Days from before the first
# stored reading are never reported.
DAILY_REPORT_CATCHUP_DAYS=3

# --- High-consumption alert ----------------------------------------------- #

HIGH_CONSUMPTION_ALERTS_ENABLED=true

# Alert when consumption since local midnight reaches this many meter units.
# 0.5 m³ = 500 litres in one day.
HIGH_CONSUMPTION_THRESHOLD=0.5

# At most one daily alert per this many hours (24 = once per day).
HIGH_CONSUMPTION_COOLDOWN_HOURS=24

# Optional short-window threshold; leave empty to disable. Catches bursts that
# never reach the daily limit, e.g. 0.2 m³ within an hour.
#HOURLY_HIGH_CONSUMPTION_THRESHOLD=0.2
HOURLY_WINDOW_MINUTES=60
HOURLY_HIGH_CONSUMPTION_COOLDOWN_HOURS=3

# --- Continuous-flow alert ------------------------------------------------ #

CONTINUOUS_FLOW_ENABLED=true

# Alert when water flows without interruption for longer than this.
CONTINUOUS_FLOW_DURATION_HOURS=3

# Minimum increase between two consecutive readings that counts as "flowing".
# 0.001 m³ = 1 litre per 5-minute interval ≈ 12 L/h. Raise it if a dripping
# fitting produces false alarms; lower it to catch smaller leaks.
FLOW_DETECTION_THRESHOLD=0.001

# Send a reminder every N hours while the flow continues. 0 = alert only once.
CONTINUOUS_FLOW_REALERT_HOURS=0

# --- Alerts in general ---------------------------------------------------- #

# Suppress alerts derived from readings older than this. Prevents a backfill
# after long downtime from mailing about a leak that ended days ago.
ALERT_MAX_AGE_HOURS=24

# --- Email ---------------------------------------------------------------- #

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=watermate@example.com
SMTP_PASSWORD=change-me

# starttls (587, typical) | implicit (465, TLS from the first byte) | none
SMTP_TLS=starttls

# Set to false only for a self-signed internal mail server.
SMTP_REJECT_UNAUTHORIZED=true

# Check the SMTP login at startup and log the result.
SMTP_VERIFY_ON_START=false

MAIL_FROM=WaterMate <watermate@example.com>

# Comma or semicolon separated.
MAIL_TO=you@example.com

# Recipients for alerts, if they differ from the report recipients.
#MAIL_ALERT_TO=you@example.com,phone@example.com

MAIL_SUBJECT_PREFIX=[WaterMate]

# Log mails instead of sending them. Ideal for the first run — no SMTP needed.
MAIL_DRY_RUN=false

# --- Storage and logging -------------------------------------------------- #

DATABASE_PATH=./data/watermate.db

# Delete readings older than N days. 0 keeps everything (a year of 5-minute
# readings is only a few MB, so keeping it all is usually fine).
DATA_RETENTION_DAYS=0

# error | warn | info | debug | trace
LOG_LEVEL=info

# pretty (human readable) | json (for journald, Loki, ...)
LOG_FORMAT=pretty
